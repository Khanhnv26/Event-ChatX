                  "type": "integer"
                },
                "description": "Seconds until retry"
              }
            }
          },
          "503": {
            "description": "Rate limiter unavailable; Retry-After: 1"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmation"
              }
            }
          }
        }
      }
    },
    "/rooms/{slug}/decisions/{decisionId}/status": {
      "patch": {
        "summary": "Host transitions decision status",
        "security": [
          {
            "HostToken": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "decisionId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or room state"
          },
          "403": {
            "description": "Missing, invalid, wrong-room, or revoked credentials"
          },
          "429": {
            "description": "Token bucket depleted",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until retry"
              }
            }
          },
          "503": {
            "description": "Rate limiter unavailable; Retry-After: 1"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionStatus"
              }
            }
          }
        }
      }
    },
    "/rooms/{slug}/export": {
      "get": {
        "summary": "Host exports report including all polls and wheels",
        "security": [
          {
            "HostToken": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or room state"
          },
          "403": {
            "description": "Missing, invalid, wrong-room, or revoked credentials"
          }
        }
