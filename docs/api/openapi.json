  },
  "components": {
    "securitySchemes": {
      "SessionToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Session-Token"
      },
      "HostToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Host-Token"
      }
    },
    "schemas": {
      "CreateRoom": {
        "type": "object",
        "required": [
          "title",
          "hostNickname"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "hostNickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "ttlMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 10080
          },
          "ttlHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 168
          }
        },
        "description": "Omit both TTL fields for 1440 minutes. Send at most one TTL field."
      },
      "JoinRoom": {
        "type": "object",
        "required": [
          "nickname"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "JoinLock": {
        "type": "object",
        "required": [
          "joinLocked"
        ],
        "properties": {
          "joinLocked": {
            "type": "boolean"
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "clientMessageId",
          "body"
        ],
        "properties": {
          "clientMessageId": {
            "type": "string",
            "maxLength": 64
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "replyToId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Poll": {
        "type": "object",
        "required": [
          "question",
          "options"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "allowMultiple": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Vote": {
        "type": "object",
        "required": [
          "optionId"
        ],
        "properties": {
          "optionId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Wheel": {
        "type": "object",
        "required": [
          "title",
          "entries"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "excludeWinner": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Spin": {
        "type": "object",
        "required": [
          "idempotencyKey"
        ],
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposeImmediately": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "Confirmation": {
        "type": "object",
        "required": [
          "choice"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          }
        }
      },
      "DecisionStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROPOSED",
              "CONFIRMED",
              "REJECTED"
            ]
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true,
            "description": "Payload documented per endpoint in docs/api/README.md."
          }
        }
      }
    }
  }
}
