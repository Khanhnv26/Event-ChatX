{$APP_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	root * /usr/share/caddy/html

	@private path /internal /internal/* /actuator /actuator/*
	handle @private {
		respond 404
	}

	@upload path_regexp upload ^/api/v1/rooms/[^/]+/attachments$
	handle @upload {
		request_body {
			max_size 22020096
		}
		reverse_proxy backend:8080 {
			transport http {
				response_header_timeout 60s
			}
		}
	}

	@backend path /api/* /ws /ws/*
	handle @backend {
		request_body {
			max_size 65536
		}
		reverse_proxy backend:8080
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
