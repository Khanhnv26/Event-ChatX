# ------------------------------------------------------------------------------
# GitHub Linguist Overrides
# Tối ưu nhận diện ngôn ngữ: Ưu tiên Java làm ngôn ngữ chính (Primary Language)
# ------------------------------------------------------------------------------

# Loại trừ toàn bộ tests khỏi thống kê ngôn ngữ
frontend/tests/* linguist-vendored=true linguist-documentation=true
frontend/tests/** linguist-vendored=true linguist-documentation=true
*.test.ts linguist-vendored=true linguist-documentation=true
*.test.tsx linguist-vendored=true linguist-documentation=true
*.spec.ts linguist-vendored=true linguist-documentation=true
*.spec.tsx linguist-vendored=true linguist-documentation=true

# Loại trừ file cấu hình build / tooling
*.config.ts linguist-vendored=true linguist-documentation=true
*.config.js linguist-vendored=true linguist-documentation=true
*.config.mjs linguist-vendored=true linguist-documentation=true
frontend/vite.config.ts linguist-vendored=true linguist-documentation=true
frontend/vitest.config.ts linguist-vendored=true linguist-documentation=true
frontend/tsconfig*.json linguist-vendored=true linguist-documentation=true

# Loại trừ promo, scripts và documentation
promo/* linguist-vendored=true linguist-documentation=true
promo/** linguist-vendored=true linguist-documentation=true
scripts/* linguist-vendored=true linguist-documentation=true
scripts/** linguist-vendored=true linguist-documentation=true
docs/* linguist-documentation=true
docs/** linguist-documentation=true
