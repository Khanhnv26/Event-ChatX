# Copy to `.env` (in this folder or in your video project) and fill in.
# `.env` is git-ignored. Real environment variables always win over this file.

# Gemini API key: voice-over (Gemini TTS), cut verification and `judge`.
# Get one at https://aistudio.google.com/apikey
# Leave empty and build with `--no-voice` to render captions + music only.
GEMINI_API_KEY=

# Optional: path to Chrome / Chromium / Edge if auto-detection fails.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: key for the example OpenAI voice provider (examples/voice-providers/openai.mjs).
# OPENAI_API_KEY=
